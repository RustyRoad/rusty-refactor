{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "moduleResolution": "Node16",
    "rootDir": "src/test",
    "outDir": "out/test",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode",
      "mocha"
    ]
  },
  "include": [
    "src/test/**/*.ts"
  ]
}

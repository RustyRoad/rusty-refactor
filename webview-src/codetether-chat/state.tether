// Generates the browser-side Codetether chat state runtime.
//
// TetherScript is the editable source of truth for the chat state contract.
// The browser runtime template stays in JavaScript because VS Code webviews
// execute JavaScript, while this file owns the schema and generated artifact.

// Defines the rich chat state contract consumed by the webview runtime.
fn chat_state_spec() {
    let defaults = map()
    defaults.busy = false
    defaults.statusText = "Ready"
    defaults.busyStatusText = "Working..."
    defaults.modelStatus = "Loading models..."
    defaults.modelFilter = ""
    defaults.activeThreadId = ""
    defaults.sessionView = "active"
    defaults.mode = "chat"
    defaults.feature = "auto"
    defaults.includeContext = true
    defaults.speechBackend = "server"
    defaults.voiceInputSupported = false
    defaults.voiceInputActive = false
    defaults.voiceInputSource = "windows-default"
    defaults.subagentSummary = ""
    let model_options = map()
    model_options.bedrockThinkingEffort = "medium"
    model_options.bedrockServiceTier = "default"
    model_options.codexThinkingEffort = "default"
    model_options.openRouterThinkingEffort = "default"
    defaults.modelOptions = model_options

    let spec = map()
    spec.version = 6
    spec.name = "codetether-chat-state"
    spec.defaults = defaults
    spec.messageFields = [
        "id",
        "role",
        "content",
        "thinking",
        "phase",
        "modelId",
        "streaming",
        "error",
        "sessionId",
        "toolEvents",
        "autoSpeak",
        "createdAt",
        "threadId"
    ]
    spec.modelFields = [
        "id",
        "name",
        "provider"
    ]
    spec.threadFields = [
        "id",
        "title",
        "busy",
        "statusText",
        "updatedAt",
        "sessionId"
    ]
    spec.actions = [
        "appendMessage",
        "chatThreadsListed",
        "clearChat",
        "clearMessages",
        "clearThreadMessages",
        "hostMessageReceived",
        "modelsListed",
        "replaceThreadMessages",
        "sessionsListed",
        "setActiveThread",
        "setActiveProvider",
        "setBusy",
        "setCustomModel",
        "setDraft",
        "setFeature",
        "setIncludeContext",
        "setMode",
        "setModelStatus",
        "setModelFilter",
        "setModelOptions",
        "setSelectedModel",
        "setSelectedVoice",
        "setSessionView",
        "setSpeakingMessage",
        "setSpeechBackend",
        "setSpeechVoices",
        "setSpeechSupported",
        "setSubagents",
        "setVoiceInputActive",
        "setVoiceInputSource",
        "setVoiceInputSources",
        "setVoiceInputSupported",
        "toggleProvider",
        "upsertStreamingMessage"
    ]
    let model_option_choices = map()
    model_option_choices.bedrockThinkingEfforts = [
        "low",
        "medium",
        "high"
    ]
    model_option_choices.bedrockServiceTiers = [
        "default",
        "standard",
        "priority"
    ]
    model_option_choices.codexThinkingEfforts = [
        "default",
        "none",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
    ]
    model_option_choices.openRouterThinkingEfforts = [
        "default",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
    ]
    spec.modelOptionChoices = model_option_choices
    spec.modes = [
        "chat",
        "agent",
        "orchestrate",
        "plan",
        "review"
    ]
    spec.features = [
        "auto",
        "code",
        "debug",
        "refactor",
        "search",
        "test",
        "git",
        "browser",
        "swarm",
        "prd"
    ]
    spec.messageRoles = [
        "user",
        "assistant",
        "system",
        "tool"
    ]
    spec.toolEventKinds = [
        "call",
        "result"
    ]
    return spec
}

// Reads the browser runtime template from the webview source tree.
fn runtime_template() {
    let path = path_join([
        "webview-src",
        "codetether-chat",
        "state-runtime.template.js"
    ]).unwrap()
    fs_read(path).unwrap()
}

// Replaces the schema placeholder with generated JSON.
fn render_runtime(template, spec_json) {
    template.replace("__CODETETHER_CHAT_STATE_SPEC__", spec_json)
}

// Writes the generated browser runtime into the packaged media directory.
fn main() {
    let spec_json = json_encode_pretty(chat_state_spec())
    let source = render_runtime(runtime_template(), spec_json)
    fs_write("media/chat-sidebar-state.generated.js", source).unwrap()
    println("generated media/chat-sidebar-state.generated.js")
}
